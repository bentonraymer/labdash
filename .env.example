# Copy to .env next to docker-compose.yml and fill in:
#   cp .env.example .env

# Required. Encrypts stored credentials (Pushover, NPM, Proxmox).
# Generate with:  openssl rand -hex 32
# Keep it safe and don't change it later, or saved credentials can't be decrypted.
LABDASH_SECRET=

# Port LabDash listens on (host networking, so this is the port on the host).
PORT=8080

# Time zone for schedules (scans, maintenance windows, nightly backups) and log times,
# e.g. America/Chicago or Europe/London.
TZ=UTC

# Image tag: "latest" (newest release), "edge" (newest main build) or a version like "0.1.0".
LABDASH_TAG=latest
